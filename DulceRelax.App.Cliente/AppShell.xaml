<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DulceRelax.App.Cliente.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DulceRelax.App.Cliente.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="DulceRelax">

    <!-- Pantalla inicial: inicio de sesión (raíz de la navegación) -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:InicioSesionCliente}"
        Route="InicioSesionCliente" />

</Shell>