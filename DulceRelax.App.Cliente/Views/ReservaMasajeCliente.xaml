<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DulceRelax.App.Cliente.ViewModels"
             x:Class="DulceRelax.App.Cliente.Views.ReservaMasajeCliente"
             x:DataType="vm:ReservaViewModel"
             Title="Solicitar cita"
             BackgroundColor="#FBF6F2"
             Shell.NavBarIsVisible="False">

	<ContentPage.Resources>
		<Style x:Key="Etiqueta" TargetType="Label">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontAttributes" Value="Bold" />
			<Setter Property="TextColor" Value="#333333" />
		</Style>

		<Style x:Key="Campo" TargetType="Border">
			<Setter Property="BackgroundColor" Value="White" />
			<Setter Property="Stroke" Value="#DDDDD9" />
			<Setter Property="StrokeThickness" Value="1" />
			<Setter Property="HeightRequest" Value="48" />
			<Setter Property="Padding" Value="12,0" />
			<Setter Property="Margin" Value="0,0,0,10" />
			<Setter Property="StrokeShape">
				<Setter.Value>
					<RoundRectangle CornerRadius="12" />
				</Setter.Value>
			</Setter>
		</Style>
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="15">

			<HorizontalStackLayout Spacing="10">
				<Button Text="← Atrás"
                        BackgroundColor="#3F8758"
                        TextColor="White"
                        Padding="15,10"
                        CornerRadius="12"
                        FontSize="14"
                        Clicked="OnBackClicked"
                        VerticalOptions="Center" />
				<Label Text="Solicitar cita"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#222222"
                       VerticalOptions="Center" />
			</HorizontalStackLayout>

			<Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="12"
                    HorizontalOptions="Fill">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="20" />
				</Border.StrokeShape>

				<Grid ColumnDefinitions="80,*" ColumnSpacing="12">

					<Border Grid.Column="0"
                            WidthRequest="80"
                            HeightRequest="80"
                            BackgroundColor="#D2E5D5"
                            StrokeThickness="0"
                            Padding="0">
						<Border.StrokeShape>
							<RoundRectangle CornerRadius="12" />
						</Border.StrokeShape>
						<Image Source="{Binding Masaje.ImagenUrl, TargetNullValue=masaje1.jpg, FallbackValue=masaje1.jpg}"
                               WidthRequest="80"
                               HeightRequest="80"
                               Aspect="AspectFill" />
					</Border>

					<VerticalStackLayout Grid.Column="1"
                                         Spacing="4"
                                         VerticalOptions="Center">
						<Label Text="{Binding Masaje.Nombre}"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#292929"
                               LineBreakMode="TailTruncation"
                               MaxLines="2" />

						<Border BackgroundColor="#EAF4EC"
                                StrokeThickness="0"
                                Padding="10,4"
                                HorizontalOptions="Start">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="12" />
							</Border.StrokeShape>
							<Label Text="{Binding Masaje.Precio, StringFormat='Precio: {0:0.##} C$'}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#3F8758" />
						</Border>

						<Label Text="{Binding Masaje.DuracionMinutos, StringFormat='◷ Duración: {0} min'}"
                               IsVisible="{Binding TieneDuracion}"
                               FontSize="11"
                               TextColor="#777777" />
					</VerticalStackLayout>

				</Grid>
			</Border>

			<Border BackgroundColor="#EAF4EC"
                    StrokeThickness="0"
                    Padding="14,10">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="12" />
				</Border.StrokeShape>
				<Label Text="ⓘ Las citas deben solicitarse con al menos 5 días de anticipación."
                       FontSize="12"
                       TextColor="#3F8758" />
			</Border>

			<Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="20"
                    HorizontalOptions="Fill">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="20" />
				</Border.StrokeShape>

				<VerticalStackLayout Spacing="8">

					<Label Text="Fecha" Style="{StaticResource Etiqueta}" />
					<Border Style="{StaticResource Campo}">
						<DatePicker MinimumDate="{Binding FechaMinima}"
                                    Date="{Binding Fecha}"
                                    Format="dd/MM/yyyy"
                                    BackgroundColor="Transparent"
                                    FontSize="14" />
					</Border>

					<Label Text="Hora" Style="{StaticResource Etiqueta}" />
					<Border Style="{StaticResource Campo}">
						<TimePicker Time="{Binding Hora}"
                                    BackgroundColor="Transparent"
                                    FontSize="14" />
					</Border>

					<Label Text="Teléfono" Style="{StaticResource Etiqueta}" />
					<Border Style="{StaticResource Campo}">
						<Entry Text="{Binding Telefono}"
                               Placeholder="Número de contacto"
                               Keyboard="Telephone"
                               BackgroundColor="Transparent"
                               FontSize="14" />
					</Border>

					<Label Text="Dirección exacta" Style="{StaticResource Etiqueta}" />
					<Border Style="{StaticResource Campo}">
						<Entry Text="{Binding Direccion}"
                               Placeholder="Dónde será el masaje"
                               BackgroundColor="Transparent"
                               FontSize="14" />
					</Border>

					<Label Text="Referencias (opcional)" Style="{StaticResource Etiqueta}" />
					<Border Style="{StaticResource Campo}">
						<Entry Text="{Binding Detalle}"
                               Placeholder="Casa azul, portón negro..."
                               BackgroundColor="Transparent"
                               FontSize="14" />
					</Border>

				</VerticalStackLayout>
			</Border>

			<Label Text="{Binding Error}"
                   IsVisible="{Binding HayError}"
                   FontSize="13"
                   TextColor="#B3261E"
                   HorizontalTextAlignment="Center" />

			<ActivityIndicator IsRunning="{Binding Enviando}"
                               IsVisible="{Binding Enviando}"
                               Color="#3F8758" />

			<Button Text="Solicitar cita"
                    Command="{Binding ReservarCommand}"
                    HeightRequest="50"
                    CornerRadius="15"
                    BackgroundColor="#3F8758"
                    TextColor="White"
                    FontSize="15"
                    FontAttributes="Bold" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>