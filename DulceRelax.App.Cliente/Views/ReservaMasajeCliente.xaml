<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DulceRelax.App.Cliente.Views.ReservaMasajeCliente"
             Title="Reservar Masaje"
             BackgroundColor="#FBF6F2"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <HorizontalStackLayout HorizontalOptions="FillAndExpand" Spacing="10">
                <Button x:Name="BackButton"
                        Text="← Atrás"
                        BackgroundColor="#3F8758"
                        TextColor="White"
                        Padding="15,10"
                        CornerRadius="12"
                        FontSize="14"
                        Clicked="OnBackClicked"
                        VerticalOptions="Center"
                        HorizontalOptions="Start" />
                <Label Text="Reservar Masaje"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#222222"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="25"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label Text="Tipo de Masaje"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#333333" />

                    <Border BackgroundColor="White"
                            Stroke="#DDDDD9"
                            StrokeThickness="1"
                            HeightRequest="48"
                            Padding="12,0"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Picker Title="Selecciona un masaje"
                                BackgroundColor="Transparent"
                                FontSize="14" />
                    </Border>

                    <Label Text="Fecha"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#333333" />

                    <Border BackgroundColor="White"
                            Stroke="#DDDDD9"
                            StrokeThickness="1"
                            HeightRequest="48"
                            Padding="12,0"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <DatePicker BackgroundColor="Transparent"
                                    FontSize="14" />
                    </Border>

                    <Label Text="Hora"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#333333" />

                    <Border BackgroundColor="White"
                            Stroke="#DDDDD9"
                            StrokeThickness="1"
                            HeightRequest="48"
                            Padding="12,0"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <TimePicker BackgroundColor="Transparent"
                                    FontSize="14" />
                    </Border>

                    <Label Text="Duración"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#333333" />

                    <Border BackgroundColor="White"
                            Stroke="#DDDDD9"
                            StrokeThickness="1"
                            HeightRequest="48"
                            Padding="12,0"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Picker Title="Selecciona duración"
                                BackgroundColor="Transparent"
                                FontSize="14" />
                    </Border>

                    <Button x:Name="ReserveButton"
                            Text="Reservar"
                            HeightRequest="50"
                            CornerRadius="15"
                            BackgroundColor="#3F8758"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            Clicked="OnReserveClicked"
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>