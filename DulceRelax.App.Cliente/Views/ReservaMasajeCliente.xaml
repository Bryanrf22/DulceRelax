<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:vm="clr-namespace:DulceRelax.App.Cliente.ViewModels"
             x:Class="DulceRelax.App.Cliente.Views.ReservaMasajeCliente"
             x:DataType="vm:ReservaViewModel"
             Title="Solicitar cita"
             BackgroundColor="{StaticResource SurfaceAlt}"
             Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>

	<ContentPage.Resources>
		<Style x:Key="Etiqueta" TargetType="Label">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontAttributes" Value="Bold" />
			<Setter Property="TextColor" Value="{StaticResource OnSurface}" />
		</Style>

		<Style x:Key="Campo" TargetType="Border">
			<Setter Property="BackgroundColor" Value="White" />
			<Setter Property="Stroke" Value="{StaticResource BorderStrong}" />
			<Setter Property="StrokeThickness" Value="1" />
			<Setter Property="HeightRequest" Value="48" />
			<Setter Property="Padding" Value="12,0" />
			<Setter Property="Margin" Value="0,0,0,10" />
			<Setter Property="StrokeShape">
				<Setter.Value>
					<RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
				</Setter.Value>
			</Setter>
		</Style>
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Padding="{StaticResource PaddingLg}" Spacing="{StaticResource SpacingMd}">

			<HorizontalStackLayout Spacing="{StaticResource SpacingMd}">
				<Button Text="Atrás"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource OnPrimary}"
                        Padding="15,10"
                        CornerRadius="{StaticResource CornerRadiusMd}"
                        FontSize="{StaticResource FontBodySmall}"
                        ContentLayout="Left,8"
                        Clicked="OnBackClicked"
                        VerticalOptions="Center">
					<Button.ImageSource>
						<FontImageSource FontFamily="MaterialIcons"
                                         Glyph="{StaticResource IconoAtras}"
                                         Color="White"
                                         Size="18" />
					</Button.ImageSource>
				</Button>
				<Label Text="Solicitar cita"
                       FontSize="{StaticResource FontTitle}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnSurface}"
                       VerticalOptions="Center" />
			</HorizontalStackLayout>

			<Border BackgroundColor="{StaticResource Surface}"
                    StrokeThickness="0"
                    Padding="{StaticResource PaddingMd}"
                    HorizontalOptions="Fill">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
				</Border.StrokeShape>

				<Grid ColumnDefinitions="80,*" ColumnSpacing="{StaticResource SpacingMd}">

					<Border Grid.Column="0"
                            WidthRequest="80"
                            HeightRequest="80"
                            BackgroundColor="{StaticResource PrimarySoftStrong}"
                            StrokeThickness="0"
                            Padding="{StaticResource PaddingSm}">
						<Border.StrokeShape>
							<RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
						</Border.StrokeShape>
						<Image Source="{Binding Masaje.ImagenUrl, TargetNullValue=masaje1.jpg, FallbackValue=masaje1.jpg}" SemanticProperties.Description="Imagen del masaje"                               WidthRequest="80"
                               HeightRequest="80"
                               Aspect="AspectFill" />
					</Border>

					<VerticalStackLayout Grid.Column="1"
                                         Spacing="{StaticResource SpacingSm}"
                                         VerticalOptions="Center">
						<Label Text="{Binding Masaje.Nombre}"
                               FontSize="{StaticResource FontHeading}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnSurface}"
                               LineBreakMode="TailTruncation"
                               MaxLines="2" />

						<Border BackgroundColor="{StaticResource PrimarySoft}"
                                StrokeThickness="0"
                                Padding="{StaticResource PaddingSm}"
                                HorizontalOptions="Start">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
							</Border.StrokeShape>
							<Label Text="{Binding Masaje.Precio, StringFormat='Precio: {0:0.##} C$'}"
                                   FontSize="{StaticResource FontCaption}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
						</Border>

						<HorizontalStackLayout Spacing="{StaticResource SpacingSm}" IsVisible="{Binding TieneDuracion}">
							<Label Text="{StaticResource IconoReloj}"
                                   Style="{StaticResource Icono}"
                                   FontSize="{StaticResource FontCaption}" />
							<Label Text="{Binding Masaje.DuracionMinutos, StringFormat='Duración: {0} min'}"
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   VerticalOptions="Center" />
						</HorizontalStackLayout>
					</VerticalStackLayout>

				</Grid>
			</Border>

			<Border BackgroundColor="{StaticResource PrimarySoft}"
                    StrokeThickness="0"
                    Padding="14,10">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
				</Border.StrokeShape>
				<HorizontalStackLayout Spacing="{StaticResource SpacingSm}">
					<Label Text="{StaticResource IconoInfo}"
                           Style="{StaticResource Icono}"
                           FontSize="{StaticResource FontBodySmall}"
                           TextColor="{StaticResource Primary}" />
					<Label Text="Las citas deben solicitarse con al menos 5 días de anticipación."
                           FontSize="{StaticResource FontCaption}"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center" />
				</HorizontalStackLayout>
			</Border>

			<Border BackgroundColor="{StaticResource Surface}"
                    StrokeThickness="0"
                    Padding="{StaticResource PaddingLg}"
                    HorizontalOptions="Fill">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
				</Border.StrokeShape>

				<VerticalStackLayout Spacing="{StaticResource SpacingSm}">

                    <Label Text="Fecha" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <DatePicker MinimumDate="{Binding FechaMinima}"
                            Date="{Binding Fecha}"
                            Format="dd/MM/yyyy"
                            TextColor="{StaticResource OnSurface}"
                            BackgroundColor="Transparent"
                            FontSize="{StaticResource FontBodySmall}" />
                    </Border>

                    <Label Text="Hora" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <TimePicker Time="{Binding Hora}"
                            TextColor="{StaticResource OnSurface}"
                            BackgroundColor="Transparent"
                            FontSize="{StaticResource FontBodySmall}" />
                    </Border>

                    <Label Text="{Binding HorarioDiaTexto}"
                       IsVisible="{Binding HayHorarioDia}"
                       FontSize="{StaticResource FontCaption}"
                       TextColor="{StaticResource OnSurfaceVariant}" />

                    <Label Text="Teléfono" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingSm}">
                            <Label Grid.Column="0"
                                   Text="{StaticResource IconoTelefono}"
                                   Style="{StaticResource Icono}"
                                   FontSize="{StaticResource FontBody}" />
                            <Entry Grid.Column="1"
                           Text="{Binding Telefono}"
                           Placeholder="Número de contacto"
                           Keyboard="Telephone"
                           TextColor="{StaticResource OnSurface}"
                           PlaceholderColor="{StaticResource OnSurfaceMuted}"
                           VerticalOptions="Center"
                           BackgroundColor="Transparent"
                           FontSize="{StaticResource FontBodySmall}" />
                        </Grid>
                    </Border>

                    <Label Text="Dirección exacta" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingSm}">
                            <Label Grid.Column="0"
                                   Text="{StaticResource IconoUbicacion}"
                                   Style="{StaticResource Icono}"
                                   FontSize="{StaticResource FontBody}" />
                            <Entry Grid.Column="1"
                           Text="{Binding Direccion}"
                           Placeholder="Dónde será el masaje"
                           TextColor="{StaticResource OnSurface}"
                           PlaceholderColor="{StaticResource OnSurfaceMuted}"
                           VerticalOptions="Center"
                           BackgroundColor="Transparent"
                           FontSize="{StaticResource FontBodySmall}" />
                        </Grid>
                    </Border>

                    <Label Text="Referencias (opcional)" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <Entry Text="{Binding Detalle}"
                           Placeholder="Casa azul, portón negro..."
                           TextColor="{StaticResource OnSurface}"
                           PlaceholderColor="{StaticResource OnSurfaceMuted}"
                           BackgroundColor="Transparent"
                           FontSize="{StaticResource FontBodySmall}" />
                    </Border>

                </VerticalStackLayout>
			</Border>

			<Label Text="{Binding Error}"
                   IsVisible="{Binding HayError}"
                   FontSize="{StaticResource FontBodySmall}"
                   TextColor="{StaticResource Error}"
                   HorizontalTextAlignment="Center" />

			<ActivityIndicator IsRunning="{Binding Enviando}"
                               IsVisible="{Binding Enviando}"
                               Color="{StaticResource Primary}" />

			<Button Text="Solicitar cita"
                    Command="{Binding ReservarCommand}"
                    HeightRequest="50"
                    CornerRadius="{StaticResource CornerRadiusMd}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource OnPrimary}"
                    FontSize="{StaticResource FontBody}"
                    FontAttributes="Bold"  automation_id="reservamasaje_solicitar_cita" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>