<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             x:Class="DulceRelax.App.Cliente.Views.RegistroCliente"
             Shell.NavBarIsVisible="False" >
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>
            

    <ScrollView>
        <VerticalStackLayout
            Padding="{StaticResource PaddingLg}"
            Spacing="{StaticResource SpacingSm}"
            VerticalOptions="Center">

            <Image
                Source="logo.png"
                SemanticProperties.Description="Logo DulceRelax"
                HeightRequest="120"
                WidthRequest="120"
                Aspect="AspectFit"
                HorizontalOptions="Center"
                Margin="0,0,0,20" />

            <Border
                BackgroundColor="{StaticResource Surface}"
                StrokeThickness="0"
                Padding="{StaticResource PaddingLg}"
                HorizontalOptions="Fill">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="{StaticResource SpacingSm}">

                    <Label
                        Text="Registro"
                        FontSize="{StaticResource FontDisplay}"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="{StaticResource OnSurface}"
                        Margin="0,0,0,5" />

                    <Label
                        Text="Cree su cuenta para continuar"
                        FontSize="{StaticResource FontBody}"
                        HorizontalOptions="Center"
                        TextColor="{StaticResource OnSurfaceVariant}"
                        Margin="0,0,0,20" />

                    <Label
                        Text="Correo electrónico"
                        FontSize="{StaticResource FontBodySmall}"
                        FontAttributes="Bold"
                        TextColor="{StaticResource OnSurface}" />

                    <Border
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource BorderStrong}"
                        StrokeThickness="1"
                        HeightRequest="48"
                        Padding="12,0"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingSm}">
                            <Label Grid.Column="0"
                                Text="{StaticResource IconoCorreo}"
                                Style="{StaticResource Icono}"
                                FontSize="{StaticResource FontHeading}" />
                            <Entry Grid.Column="1"
                                Text="{Binding Email}"
                                x:Name="EmailEntry"
                                Placeholder="ejemplo@email.com"
                                Keyboard="Email"
                                ClearButtonVisibility="WhileEditing"
                                FontSize="{StaticResource FontBodySmall}"
                                TextColor="{StaticResource OnSurface}"
                                PlaceholderColor="{StaticResource OnSurfaceMuted}"
                                VerticalOptions="Center"
                                BackgroundColor="Transparent" />
                        </Grid>
                    </Border>

                    <Label
                        Text="Contraseña"
                        FontSize="{StaticResource FontBodySmall}"
                        FontAttributes="Bold"
                        TextColor="{StaticResource OnSurface}" />

                    <Border
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource BorderStrong}"
                        StrokeThickness="1"
                        HeightRequest="48"
                        Padding="12,0"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingSm}">
                            <Label Grid.Column="0"
                                Text="{StaticResource IconoCandado}"
                                Style="{StaticResource Icono}"
                                FontSize="{StaticResource FontHeading}" />
                            <Entry Grid.Column="1"
                                Text="{Binding Password}"
                                x:Name="PasswordEntry"
                                Placeholder="Contraseña"
                                IsPassword="True"
                                FontSize="{StaticResource FontBodySmall}"
                                TextColor="{StaticResource OnSurface}"
                                PlaceholderColor="{StaticResource OnSurfaceMuted}"
                                VerticalOptions="Center"
                                BackgroundColor="Transparent" />
                                        <Button Grid.Column="2"
                                                x:Name="PasswordToggle"
                                                Text="{StaticResource IconoVer}"
                                                Style="{StaticResource IconButton}"
                                                Clicked="OnTogglePassword"
                                                SemanticProperties.Description="Mostrar u ocultar contraseña"
                                                AutomationId="registro_password_toggle" />
                        </Grid>
                    </Border>

                    <Label
                        Text="Nombre"
                        FontSize="{StaticResource FontBodySmall}"
                        FontAttributes="Bold"
                        TextColor="{StaticResource OnSurface}" />

                    <Border
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource BorderStrong}"
                        StrokeThickness="1"
                        HeightRequest="48"
                        Padding="12,0"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingSm}">
                            <Label Grid.Column="0"
                                Text="{StaticResource IconoPerfil}"
                                Style="{StaticResource Icono}"
                                FontSize="{StaticResource FontHeading}" />
                            <Entry Grid.Column="1"
                                Text="{Binding Nombre}"
                                x:Name="NombreNuevoRegistro"
                                Placeholder="Nombre"
                                ClearButtonVisibility="WhileEditing"
                                FontSize="{StaticResource FontBodySmall}"
                                TextColor="{StaticResource OnSurface}"
                                PlaceholderColor="{StaticResource OnSurfaceMuted}"
                                VerticalOptions="Center"
                                BackgroundColor="Transparent" />
                        </Grid>
                    </Border>

                    <Label
                        Text="Teléfono"
                        FontSize="{StaticResource FontBodySmall}"
                        FontAttributes="Bold"
                        TextColor="{StaticResource OnSurface}" />

                    <Border
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource BorderStrong}"
                        StrokeThickness="1"
                        HeightRequest="48"
                        Padding="12,0"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingSm}">
                            <Label Grid.Column="0"
                                Text="{StaticResource IconoTelefono}"
                                Style="{StaticResource Icono}"
                                FontSize="{StaticResource FontHeading}" />
                            <Entry Grid.Column="1"
                                Text="{Binding Telefono}"
                                x:Name="TelefonoNuevoRegistro"
                                Placeholder="Número Telefónico"
                                Keyboard="Telephone"
                                ClearButtonVisibility="WhileEditing"
                                FontSize="{StaticResource FontBodySmall}"
                                TextColor="{StaticResource OnSurface}"
                                PlaceholderColor="{StaticResource OnSurfaceMuted}"
                                VerticalOptions="Center"
                                BackgroundColor="Transparent" />
                        </Grid>
                    </Border>

                    <Label
                        Text="Dirección"
                        FontSize="{StaticResource FontBodySmall}"
                        FontAttributes="Bold"
                        TextColor="{StaticResource OnSurface}" />

                    <Border
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource BorderStrong}"
                        StrokeThickness="1"
                        HeightRequest="48"
                        Padding="12,0"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingSm}">
                            <Label Grid.Column="0"
                                Text="{StaticResource IconoUbicacion}"
                                Style="{StaticResource Icono}"
                                FontSize="{StaticResource FontHeading}" />
                            <Entry Grid.Column="1"
                                Text="{Binding Direccion}"
                                x:Name="DirNuevoRegistro"
                                Placeholder="Su Dirección"
                                ClearButtonVisibility="WhileEditing"
                                FontSize="{StaticResource FontBodySmall}"
                                TextColor="{StaticResource OnSurface}"
                                PlaceholderColor="{StaticResource OnSurfaceMuted}"
                                VerticalOptions="Center"
                                BackgroundColor="Transparent" />
                        </Grid>
                    </Border>

                    <Label
                        Text="{Binding Error}"
                        HorizontalOptions="Center"
                        TextColor="Red"
                        FontSize="{StaticResource FontBodySmall}"
                        Margin="0,5,0,0" />

                    <Button
                        Text="Registrarse"
                        HeightRequest="50"
                        CornerRadius="{StaticResource CornerRadiusMd}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource OnPrimary}"
                        FontSize="{StaticResource FontBody}"
                        FontAttributes="Bold"
                        Margin="0,10,0,0"
                        Command="{Binding RegistrarCommand}">
                    </Button>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>