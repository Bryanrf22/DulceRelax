<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DulceRelax.App.Cliente.Views.RegistroCliente"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FBF6F2">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="8"
            VerticalOptions="Center">

            <Image
                Source="logo.png"
                HeightRequest="120"
                WidthRequest="120"
                Aspect="AspectFit"
                HorizontalOptions="Center"
                Margin="0,0,0,20" />

            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="25"
                HorizontalOptions="Fill">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Registro"
                        FontSize="30"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="#222222"
                        Margin="0,0,0,5" />

                    <Label
                        Text="Cree su cuenta para continuar"
                        FontSize="15"
                        HorizontalOptions="Center"
                        TextColor="#777777"
                        Margin="0,0,0,20" />

                    <Label
                        Text="Correo electrónico"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#333333" />

                    <Border
                        BackgroundColor="White"
                        Stroke="#DDDDD9"
                        StrokeThickness="1"
                        HeightRequest="48"
                        Padding="12,0"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="EmailEntry"
                            Placeholder="ejemplo@email.com"
                            Keyboard="Email"
                            ClearButtonVisibility="WhileEditing"
                            FontSize="14"
                            TextColor="#333333"
                            PlaceholderColor="#999999"
                            BackgroundColor="Transparent" />
                    </Border>

                    <Label
                        Text="Contraseña"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#333333" />

                    <Border
                        BackgroundColor="White"
                        Stroke="#DDDDD9"
                        StrokeThickness="1"
                        HeightRequest="48"
                        Padding="12,0"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="PasswordEntry"
                            Placeholder="Contraseña"
                            IsPassword="True"
                            FontSize="14"
                            TextColor="#333333"
                            PlaceholderColor="#999999"
                            BackgroundColor="Transparent" />
                    </Border>

                    <Label
                        Text="Nombre"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#333333" />

                    <Border
                        BackgroundColor="White"
                        Stroke="#DDDDD9"
                        StrokeThickness="1"
                        HeightRequest="48"
                        Padding="12,0"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="NombreNuevoRegistro"
                            Placeholder="Nombre"
                            ClearButtonVisibility="WhileEditing"
                            FontSize="14"
                            TextColor="#333333"
                            PlaceholderColor="#999999"
                            BackgroundColor="Transparent" />
                    </Border>

                    <Label
                        Text="Teléfono"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#333333" />

                    <Border
                        BackgroundColor="White"
                        Stroke="#DDDDD9"
                        StrokeThickness="1"
                        HeightRequest="48"
                        Padding="12,0"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="TelefonoNuevoRegistro"
                            Placeholder="Número Telefónico"
                            Keyboard="Telephone"
                            ClearButtonVisibility="WhileEditing"
                            FontSize="14"
                            TextColor="#333333"
                            PlaceholderColor="#999999"
                            BackgroundColor="Transparent" />
                    </Border>

                    <Label
                        Text="Dirección"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#333333" />

                    <Border
                        BackgroundColor="White"
                        Stroke="#DDDDD9"
                        StrokeThickness="1"
                        HeightRequest="48"
                        Padding="12,0"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="DirNuevoRegistro"
                            Placeholder="Su Dirección"
                            ClearButtonVisibility="WhileEditing"
                            FontSize="14"
                            TextColor="#333333"
                            PlaceholderColor="#999999"
                            BackgroundColor="Transparent" />
                    </Border>

                    <Label
                        x:Name="MessageLabel"
                        HorizontalOptions="Center"
                        TextColor="Red"
                        FontSize="13"
                        Margin="0,5,0,0" />

                    <Button
                        Text="Registrarse"
                        HeightRequest="48"
                        CornerRadius="12"
                        BackgroundColor="#3F8758"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold"
                        Margin="0,10,0,0"
                        Clicked="OnRegisterClicked">

                        <Button.GestureRecognizers>
                            <PointerGestureRecognizer
                                PointerEntered="OnRegisterEntered"
                                PointerExited="OnRegisterExited" />
                        </Button.GestureRecognizers>

                    </Button>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>