<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:vm="clr-namespace:DulceRelax.App.Cliente.ViewModels"
             x:Class="DulceRelax.App.Cliente.Views.InicioSesionCliente"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceAlt}">

    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PaddingLg}" Spacing="{StaticResource SpacingSm}" VerticalOptions="Center">
            <Image Source="logo.png" SemanticProperties.Description="Logo DulceRelax" HeightRequest="120" WidthRequest="120" Aspect="AspectFit"
                   HorizontalOptions="Center" Margin="0,0,0,20" />
            <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="{StaticResource PaddingLg}"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="{StaticResource SpacingLg}">
                    <Label Text="DulceRelax" FontSize="{StaticResource FontDisplay}" FontAttributes="Bold"
                           HorizontalOptions="Center" TextColor="{StaticResource Primary}" />
                    <Label Text="Iniciar sesión" FontSize="{StaticResource FontBody}" FontAttributes="Bold"
                           HorizontalOptions="Center" TextColor="{StaticResource OnSurface}" />
                    <Entry Placeholder="Correo electrónico" Text="{Binding Email, Mode=TwoWay}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingSm}">
                        <Entry Grid.Column="0" Placeholder="Contraseña" x:Name="PasswordEntry"
                               Text="{Binding Password, Mode=TwoWay}" IsPassword="True" />
                        <Button Grid.Column="1" x:Name="ToggleButton" Text="Mostrar"
                                Clicked="OnTogglePassword"
                                AutomationId="login_password_toggle"
                                SemanticProperties.Description="Mostrar contraseña" />
                    </Grid>
                    <Button Text="Iniciar sesión" Command="{Binding LoginCommand}" AutomationId="iniciosesion_iniciar_sesi_n" />

                    <Button Text="¿Olvidaste tu contraseña?"
                            Style="{StaticResource BtnLink}"
                            Clicked="OnForgotPasswordClicked"
                            AutomationId="login_forgot_password"
                            SemanticProperties.Description="Recuperar contraseña" />

                    <Button Text="Regístrate"
                            Style="{StaticResource BtnLink}"
                            Clicked="OnRegisterClicked"
                            AutomationId="login_register"
                            SemanticProperties.Description="Crear una cuenta" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
