<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
    xmlns:dto="clr-namespace:DulceRelax.Shared.DTOs;assembly=DulceRelax.Shared"
    xmlns:vm="clr-namespace:DulceRelax.App.Cliente.ViewModels"
    x:Class="DulceRelax.App.Cliente.Views.PrincipalCliente"
    x:DataType="vm:PrincipalViewModel"
    BackgroundColor="{StaticResource SurfaceAlt}"
    Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="*,75">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="{StaticResource PaddingXl}"
                Spacing="{StaticResource SpacingSm}">

                <Image
                    Source="logo.png"
                    SemanticProperties.Description="Logo DulceRelax"
                    HeightRequest="120"
                    WidthRequest="120"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    Margin="0,0,0,5" />

                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="{StaticResource PaddingMd}"
                    HorizontalOptions="Fill">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="{StaticResource SpacingSm}">

                        <Label
                            Text="Masajes"
                            FontSize="{StaticResource FontTitle}"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="#262626" />

                        <Label
                            Text="Masajes Disponibles"
                            FontSize="{StaticResource FontBodySmall}"
                            HorizontalOptions="Center"
                            TextColor="#888888"
                            Margin="0,0,0,18" />

                        <ActivityIndicator
                            IsRunning="{Binding Cargando}"
                            IsVisible="{Binding Cargando}"
                            Color="#3F8758" />

                        <VerticalStackLayout IsVisible="{Binding HayError}" Spacing="{StaticResource SpacingSm}">
                            <Label
                                Text="{Binding Error}"
                                FontSize="{StaticResource FontBodySmall}"
                                TextColor="#B3261E"
                                HorizontalOptions="Center" />
                            <Button
                                Text="Reintentar"
                                Command="{Binding CargarCommand}"
                                BackgroundColor="#3F8758"
                                TextColor="White"
                                CornerRadius="{StaticResource CornerRadiusSm}"
                                ContentLayout="Left,6"
                                HorizontalOptions="Center">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="{StaticResource IconoReintentar}"
                                                     Color="White"
                                                     Size="16" />
                                </Button.ImageSource>
                            </Button>
                        </VerticalStackLayout>

                        <Label
                            Text="No hay masajes disponibles por el momento"
                            IsVisible="{Binding SinMasajes}"
                            FontSize="{StaticResource FontBodySmall}"
                            TextColor="#888888"
                            HorizontalOptions="Center" />

                        <VerticalStackLayout
                            Spacing="{StaticResource SpacingMd}"
                            BindableLayout.ItemsSource="{Binding Masajes}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:MasajeDTO">

                                    <Border
                                        BackgroundColor="White"
                                        Stroke="#E0E0E0"
                                        StrokeThickness="1"
                                        Padding="{StaticResource PaddingMd}"
                                        HorizontalOptions="Fill">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                                        </Border.StrokeShape>

                                        <Grid ColumnDefinitions="100,*" ColumnSpacing="{StaticResource SpacingMd}">

                                            <Border
                                                Grid.Column="0"
                                                WidthRequest="100"
                                                HeightRequest="100"
                                                VerticalOptions="Start"
                                                BackgroundColor="#D2E5D5"
                                                StrokeThickness="0"
                                                Padding="{StaticResource PaddingSm}">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                                                </Border.StrokeShape>

                                                <Image
                                                    Source="{Binding ImagenUrl, TargetNullValue=masaje1.jpg, FallbackValue=masaje1.jpg}"
                                                    SemanticProperties.Description="Imagen del masaje"
                                                    WidthRequest="100"
                                                    HeightRequest="100"
                                                    Aspect="AspectFill" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="{StaticResource SpacingSm}">

                                                <Label
                                                    Text="{Binding Nombre}"
                                                    FontSize="{StaticResource FontBody}"
                                                    FontAttributes="Bold"
                                                    TextColor="#292929"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="2" />

                                                <Border
                                                    BackgroundColor="#EAF4EC"
                                                    StrokeThickness="0"
                                                    Padding="{StaticResource PaddingSm}"
                                                    HorizontalOptions="Start">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                                                    </Border.StrokeShape>

                                                    <Label
                                                        Text="{Binding Precio, StringFormat='Precio: {0:0.##} C$'}"
                                                        FontSize="{StaticResource FontCaption}"
                                                        FontAttributes="Bold"
                                                        TextColor="#3F8758" />
                                                </Border>

                                                <HorizontalStackLayout Spacing="{StaticResource SpacingSm}">
                                                    <HorizontalStackLayout.Triggers>
                                                        <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding DuracionMinutos}" Value="0">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </HorizontalStackLayout.Triggers>
                                                    <Label
                                                        Text="{StaticResource IconoReloj}"
                                                        Style="{StaticResource Icono}"
                                                        FontSize="{StaticResource FontCaption}" />
                                                    <Label
                                                        Text="{Binding DuracionMinutos, StringFormat='Duración: {0} min'}"
                                                        FontSize="{StaticResource FontCaption}"
                                                        TextColor="#777777"
                                                        VerticalOptions="Center" />
                                                </HorizontalStackLayout>

                                                <Label
                                                    Text="{Binding Descripcion}"
                                                    FontSize="{StaticResource FontCaption}"
                                                    TextColor="#777777"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="3" />

                                                <Button
                                                    Text="Solicitar cita"
                                                    FontSize="{StaticResource FontCaption}"
                                                    FontAttributes="Bold"
                                                    HeightRequest="30"
                                                    CornerRadius="{StaticResource CornerRadiusSm}"
                                                    Padding="{StaticResource PaddingSm}"
                                                    Margin="0,4,0,0"
                                                    BackgroundColor="#3F8758"
                                                    TextColor="White"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PrincipalViewModel}}, x:DataType=vm:PrincipalViewModel, Path=SolicitarCitaCommand}"
                                                    CommandParameter="{Binding .}"  AutomationId="principal_solicitar_cita" />

                                            </VerticalStackLayout>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <Border
            Grid.Row="1"
            BackgroundColor="White"
            Stroke="#E5E5E5"
            StrokeThickness="1"
            Padding="{StaticResource PaddingSm}">

            <Grid ColumnDefinitions="*,*,*">

                <VerticalStackLayout
                    Grid.Column="0"
                    HorizontalOptions="Center"
                    Spacing="{StaticResource SpacingSm}">

                    <Label
                        Text="{StaticResource IconoInicio}"
                        Style="{StaticResource IconoNav}"
                        TextColor="#3F8758" />

                    <Label
                        Text="Inicio"
                        FontSize="{StaticResource FontCaption}"
                        FontAttributes="Bold"
                        TextColor="#3F8758"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Spacing="{StaticResource SpacingSm}">

                    <Label
                        Text="{StaticResource IconoAgenda}"
                        Style="{StaticResource IconoNav}"
                        TextColor="#333333" />

                    <Label
                        Text="Mis Citas"
                        FontSize="{StaticResource FontCaption}"
                        TextColor="#333333"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="2"
                    HorizontalOptions="Center"
                    Spacing="{StaticResource SpacingSm}">

                    <Label
                        Text="{StaticResource IconoPerfil}"
                        Style="{StaticResource IconoNav}"
                        TextColor="#333333" />

                    <Label
                        Text="Perfil"
                        FontSize="{StaticResource FontCaption}"
                        TextColor="#333333"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </Grid>

        </Border>

    </Grid>

</ContentPage>