<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:DulceRelax.Shared.DTOs;assembly=DulceRelax.Shared"
    xmlns:vm="clr-namespace:DulceRelax.App.Cliente.ViewModels"
    x:Class="DulceRelax.App.Cliente.Views.PrincipalCliente"
    x:DataType="vm:PrincipalViewModel"
    BackgroundColor="#F5F4F0"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,75">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="10,30,10,20"
                Spacing="0">

                <Image
                    Source="logo.png"
                    HeightRequest="270"
                    WidthRequest="280"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    Margin="0,0,0,5" />

                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="10,15,10,20"
                    HorizontalOptions="Fill">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Masajes"
                            FontSize="25"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="#262626" />

                        <Label
                            Text="Masajes Disponibles"
                            FontSize="13"
                            HorizontalOptions="Center"
                            TextColor="#888888"
                            Margin="0,0,0,18" />

                        <ActivityIndicator
                            IsRunning="{Binding Cargando}"
                            IsVisible="{Binding Cargando}"
                            Color="#3F8758" />

                        <VerticalStackLayout IsVisible="{Binding HayError}" Spacing="8">
                            <Label
                                Text="{Binding Error}"
                                FontSize="13"
                                TextColor="#B3261E"
                                HorizontalOptions="Center" />
                            <Button
                                Text="Reintentar"
                                Command="{Binding CargarCommand}"
                                BackgroundColor="#3F8758"
                                TextColor="White"
                                CornerRadius="8"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <Label
                            Text="No hay masajes disponibles por el momento"
                            IsVisible="{Binding SinMasajes}"
                            FontSize="13"
                            TextColor="#888888"
                            HorizontalOptions="Center" />

                        <VerticalStackLayout
                            Spacing="12"
                            BindableLayout.ItemsSource="{Binding Masajes}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:MasajeDTO">

                                    <Border
                                        BackgroundColor="White"
                                        Stroke="#E0E0E0"
                                        StrokeThickness="1"
                                        Padding="10"
                                        HorizontalOptions="Fill">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="15" />
                                        </Border.StrokeShape>

                                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">

                                            <Border
                                                Grid.Column="0"
                                                WidthRequest="100"
                                                HeightRequest="100"
                                                VerticalOptions="Start"
                                                BackgroundColor="#D2E5D5"
                                                StrokeThickness="0"
                                                Padding="0">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>

                                                <Image
                                                    Source="{Binding ImagenUrl, TargetNullValue=masaje1.jpg, FallbackValue=masaje1.jpg}"
                                                    WidthRequest="100"
                                                    HeightRequest="100"
                                                    Aspect="AspectFill" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4">

                                                <Label
                                                    Text="{Binding Nombre}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    TextColor="#292929"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="2" />

                                                <Border
                                                    BackgroundColor="#EAF4EC"
                                                    StrokeThickness="0"
                                                    Padding="10,4"
                                                    HorizontalOptions="Start">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>

                                                    <Label
                                                        Text="{Binding Precio, StringFormat='Precio: {0:0.##} C$'}"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        TextColor="#3F8758" />
                                                </Border>

                                                <Label
                                                    Text="{Binding DuracionMinutos, StringFormat='◷ Duración: {0} min'}"
                                                    FontSize="11"
                                                    TextColor="#777777">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding DuracionMinutos}" Value="0">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <Label
                                                    Text="{Binding Descripcion}"
                                                    FontSize="10.5"
                                                    TextColor="#777777"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="3" />

                                                <Button
                                                    Text="Solicitar cita"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    HeightRequest="30"
                                                    CornerRadius="8"
                                                    Padding="0"
                                                    Margin="0,4,0,0"
                                                    BackgroundColor="#3F8758"
                                                    TextColor="White"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PrincipalViewModel}}, x:DataType=vm:PrincipalViewModel, Path=SolicitarCitaCommand}"
                                                    CommandParameter="{Binding .}" />

                                            </VerticalStackLayout>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <Border
            Grid.Row="1"
            BackgroundColor="White"
            Stroke="#E5E5E5"
            StrokeThickness="1"
            Padding="10,5">

            <Grid ColumnDefinitions="*,*,*">

                <VerticalStackLayout
                    Grid.Column="0"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <!-- PLACEHOLDER: reemplazar por home.png definitivo -->
                    <Border
                        x:Name="HomeIcon"
                        BackgroundColor="#FFF3CD"
                        Stroke="#F0AD4E"
                        StrokeThickness="2"
                        StrokeDashArray="4,2"
                        StrokeShape="RoundRectangle 6"
                        HeightRequest="40"
                        WidthRequest="40"
                        HorizontalOptions="Center">
                        <Label
                            Text="IMG"
                            FontSize="9"
                            FontAttributes="Bold"
                            TextColor="#8A6D3B"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        x:Name="HomeLabel"
                        Text="Inicio"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#3F8758"
                        HorizontalOptions="Center" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeClicked" />
                    </VerticalStackLayout.GestureRecognizers>

                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <!-- PLACEHOLDER: reemplazar por calendar.png definitivo -->
                    <Border
                        x:Name="CalendarIcon"
                        BackgroundColor="#CFF4FC"
                        Stroke="#0EA5E9"
                        StrokeThickness="2"
                        StrokeDashArray="4,2"
                        StrokeShape="RoundRectangle 6"
                        HeightRequest="40"
                        WidthRequest="40"
                        HorizontalOptions="Center">
                        <Label
                            Text="IMG"
                            FontSize="9"
                            FontAttributes="Bold"
                            TextColor="#075985"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        x:Name="CalendarLabel"
                        Text="Mis Citas"
                        FontSize="10"
                        TextColor="#333333"
                        HorizontalOptions="Center" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCalendarTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="2"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <Image
                        x:Name="ProfileIcon"
                        Source="icono.png"
                        HeightRequest="23"
                        WidthRequest="23" />

                    <Label
                        x:Name="ProfileLabel"
                        Text="Perfil"
                        FontSize="10"
                        TextColor="#333333"
                        HorizontalOptions="Center" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                </VerticalStackLayout>

            </Grid>

        </Border>

    </Grid>

</ContentPage>