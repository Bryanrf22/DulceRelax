<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:vm="clr-namespace:DulceRelax.App.Cliente.ViewModels"
             x:Class="DulceRelax.App.Cliente.Views.PerfilClienteEdit"
             x:DataType="vm:PerfilEditViewModel"
             Title="Editar Perfil"
             BackgroundColor="{StaticResource SurfaceAlt}"
             Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <Style x:Key="Etiqueta" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
        </Style>

        <Style x:Key="Campo" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource BorderStrong}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PaddingLg}" Spacing="{StaticResource SpacingMd}">

            <Label Text="Editar Perfil"
                   FontSize="{StaticResource FontTitle}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource OnSurface}"
                   Margin="5,0,0,0" />

            <Border BackgroundColor="{StaticResource Surface}"
                    StrokeThickness="0"
                    Padding="{StaticResource PaddingLg}"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="{StaticResource SpacingSm}">

                    <Label Text="Nombre" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <Entry Text="{Binding Nombre}"
                               Placeholder="Nombre completo"
                               MaxLength="80"
                               IsSpellCheckEnabled="False"
                               IsTextPredictionEnabled="False"
                               FontSize="{StaticResource FontBodySmall}"
                               TextColor="{StaticResource OnSurface}"
                               PlaceholderColor="{StaticResource OnSurfaceMuted}"
                               BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Teléfono" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <Entry Text="{Binding Telefono}"
                               Placeholder="Teléfono"
                               Keyboard="Telephone"
                               MaxLength="20"
                               FontSize="{StaticResource FontBodySmall}"
                               TextColor="{StaticResource OnSurface}"
                               PlaceholderColor="{StaticResource OnSurfaceMuted}"
                               BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Dirección" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <Entry Text="{Binding Direccion}"
                               Placeholder="Dirección"
                               MaxLength="200"
                               IsSpellCheckEnabled="False"
                               IsTextPredictionEnabled="False"
                               FontSize="{StaticResource FontBodySmall}"
                               TextColor="{StaticResource OnSurface}"
                               PlaceholderColor="{StaticResource OnSurfaceMuted}"
                               BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Correo electrónico" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}" BackgroundColor="{StaticResource SurfaceMuted}" Stroke="Transparent">
                        <Label Text="{Binding Correo}"
                               FontSize="{StaticResource FontBodySmall}"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                    </Border>
                    <Label Text="El correo identifica tu cuenta y no se puede cambiar aquí."
                           FontSize="{StaticResource FontCaption}"
                           TextColor="{StaticResource OnSurfaceMuted}" />

                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Error}"
                   IsVisible="{Binding HayError}"
                   FontSize="{StaticResource FontBodySmall}"
                   TextColor="{StaticResource Error}"
                   HorizontalTextAlignment="Center" />

            <ActivityIndicator IsRunning="{Binding Guardando}"
                               IsVisible="{Binding Guardando}"
                               Color="{StaticResource Primary}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingMd}">
                <Button Grid.Column="0"
                        Text="Guardar"
                        Command="{Binding GuardarCommand}"
                        HeightRequest="50"
                        CornerRadius="{StaticResource CornerRadiusMd}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource OnPrimary}"
                        FontSize="{StaticResource FontBody}"
                        FontAttributes="Bold"  automation_id="perfiledit_guardar" />
                <Button Grid.Column="1"
                        Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        HeightRequest="50"
                        CornerRadius="{StaticResource CornerRadiusMd}"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Border}"
                        BorderWidth="1"
                        TextColor="{StaticResource OnSurfaceVariant}"
                        FontSize="{StaticResource FontBody}"
                        FontAttributes="Bold"  automation_id="perfiledit_cancelar" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>