<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:vm="clr-namespace:DulceRelax.App.Cliente.ViewModels"
             x:Class="DulceRelax.App.Cliente.Views.MisCitasCliente"
             x:DataType="vm:MisCitasViewModel"
             Title="Mis Citas"
             BackgroundColor="{StaticResource SurfaceAlt}"
             Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="Top,Bottom" />
    </ContentPage.Behaviors>

    <RefreshView IsRefreshing="{Binding Cargando}"
                 Command="{Binding CargarCommand}"
                 RefreshColor="{StaticResource Primary}">

		<ScrollView>
			<VerticalStackLayout Padding="{StaticResource PaddingLg}" Spacing="{StaticResource SpacingMd}">

				<HorizontalStackLayout Spacing="{StaticResource SpacingMd}">
					<Button Text="Atrás"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource OnPrimary}"
                            Padding="15,10"
                            CornerRadius="{StaticResource CornerRadiusMd}"
                            FontSize="{StaticResource FontBodySmall}"
                            ContentLayout="Left,8"
                            Clicked="OnBackClicked"
                            VerticalOptions="Center">
						<Button.ImageSource>
							<FontImageSource FontFamily="MaterialIcons"
                                             Glyph="{StaticResource IconoAtras}"
                                             Color="White"
                                             Size="18" />
						</Button.ImageSource>
					</Button>
					<Label Text="Mis Citas"
                           FontSize="{StaticResource FontTitle}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnSurface}"
                           VerticalOptions="Center" />
				</HorizontalStackLayout>

				<Border BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        Padding="{StaticResource PaddingLg}"
                        IsVisible="{Binding HayError}">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
					</Border.StrokeShape>
					<VerticalStackLayout Spacing="{StaticResource SpacingMd}">
						<Label Text="{Binding Error}"
                               FontSize="{StaticResource FontBodySmall}"
                               TextColor="{StaticResource Error}"
                               HorizontalTextAlignment="Center" />
						<Button Text="Reintentar"
                                Command="{Binding CargarCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource OnPrimary}"
                                CornerRadius="{StaticResource CornerRadiusMd}"
                                ContentLayout="Left,6"
                                HorizontalOptions="Center">
							<Button.ImageSource>
								<FontImageSource FontFamily="MaterialIcons"
                                                 Glyph="{StaticResource IconoReintentar}"
                                                 Color="White"
                                                 Size="16" />
							</Button.ImageSource>
						</Button>
					</VerticalStackLayout>
				</Border>

				<Border BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        Padding="{StaticResource PaddingLg}"
                        IsVisible="{Binding SinCitas}">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
					</Border.StrokeShape>
					<Label Text="Aún no tienes citas. Solicita una desde el menú principal."
                           HorizontalTextAlignment="Center"
                           FontSize="{StaticResource FontBody}"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           Margin="0,20" />
				</Border>

				<VerticalStackLayout Spacing="{StaticResource SpacingMd}"
                                     BindableLayout.ItemsSource="{Binding Citas}">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="vm:CitaItem">

							<Border BackgroundColor="{StaticResource Surface}"
									Stroke="{StaticResource Border}"
									StrokeThickness="1"
									Padding="{StaticResource PaddingMd}"
									HorizontalOptions="Fill">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="{StaticResource CornerRadiusLg}" />
								</Border.StrokeShape>

								<VerticalStackLayout Spacing="{StaticResource SpacingSm}">

									<Label Text="{Binding MasajeNombre}"
										   FontSize="{StaticResource FontBody}"
										   FontAttributes="Bold"
										   TextColor="{StaticResource OnSurface}"
										   LineBreakMode="TailTruncation"
										   MaxLines="2" />

									<Border BackgroundColor="{Binding EstadoFondo}"
											StrokeThickness="0"
											Padding="{StaticResource PaddingSm}"
											HorizontalOptions="Start">
										<Border.StrokeShape>
											<RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
										</Border.StrokeShape>
										<Label Text="{Binding EstadoTexto}"
											   FontSize="{StaticResource FontCaption}"
											   FontAttributes="Bold"
											   TextColor="{Binding EstadoColor}" />
									</Border>

									<HorizontalStackLayout Spacing="{StaticResource SpacingSm}" Margin="0,4,0,0">
										<Label Text="{StaticResource IconoReloj}"
											   Style="{StaticResource Icono}"
											   FontSize="{StaticResource FontBodySmall}"
											   TextColor="{StaticResource OnSurfaceVariant}" />
										<Label Text="{Binding FechaHoraTexto}"
											   FontSize="{StaticResource FontBodySmall}"
											   TextColor="{StaticResource OnSurfaceVariant}"
											   VerticalOptions="Center" />
									</HorizontalStackLayout>

									<HorizontalStackLayout Spacing="{StaticResource SpacingSm}">
										<Label Text="{StaticResource IconoUbicacion}"
											   Style="{StaticResource Icono}"
											   FontSize="{StaticResource FontBodySmall}" />
										<Label Text="{Binding Direccion}"
											   FontSize="{StaticResource FontCaption}"
											   TextColor="{StaticResource OnSurfaceVariant}"
											   VerticalOptions="Center" />
									</HorizontalStackLayout>

									<Label Text="{Binding Detalle}"
										   IsVisible="{Binding TieneDetalle}"
										   FontSize="{StaticResource FontCaption}"
										   TextColor="{StaticResource OnSurfaceMuted}" />

									<HorizontalStackLayout Spacing="{StaticResource SpacingMd}"
														   Margin="0,8,0,0"
														   IsVisible="{Binding TieneAcciones}">

										<Button Text="Editar"
												IsVisible="{Binding PuedeEditar}"
												HeightRequest="36"
												Padding="18,0"
												CornerRadius="{StaticResource CornerRadiusMd}"
												FontSize="{StaticResource FontCaption}"
												FontAttributes="Bold"
												ContentLayout="Left,6"
												BackgroundColor="Transparent"
												BorderColor="{StaticResource Primary}"
												BorderWidth="1"
												TextColor="{StaticResource Primary}"
												Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MisCitasViewModel}}, x:DataType=vm:MisCitasViewModel, Path=EditarCommand}"
												CommandParameter="{Binding .}">
											<Button.ImageSource>
												<FontImageSource FontFamily="MaterialIcons"
																 Glyph="{StaticResource IconoEditar}"
																 Color="{StaticResource Primary}"
																 Size="16" />
											</Button.ImageSource>
										</Button>

										<Button Text="Cancelar"
												IsVisible="{Binding PuedeCancelar}"
												HeightRequest="36"
												Padding="18,0"
												CornerRadius="{StaticResource CornerRadiusMd}"
												FontSize="{StaticResource FontCaption}"
												FontAttributes="Bold"
												ContentLayout="Left,6"
												BackgroundColor="Transparent"
												BorderColor="{StaticResource Error}"
												BorderWidth="1"
												TextColor="{StaticResource Error}"
												Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MisCitasViewModel}}, x:DataType=vm:MisCitasViewModel, Path=CancelarCommand}"
												CommandParameter="{Binding .}">
											<Button.ImageSource>
												<FontImageSource FontFamily="MaterialIcons"
																 Glyph="{StaticResource IconoCerrar}"
																 Color="{StaticResource Error}"
																 Size="16" />
											</Button.ImageSource>
										</Button>

									</HorizontalStackLayout>

								</VerticalStackLayout>
							</Border>

						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>

			</VerticalStackLayout>
		</ScrollView>

	</RefreshView>
</ContentPage>