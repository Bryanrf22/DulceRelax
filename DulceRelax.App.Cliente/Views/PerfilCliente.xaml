<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:vm="clr-namespace:DulceRelax.App.Cliente.ViewModels"
             x:Class="DulceRelax.App.Cliente.Views.PerfilCliente"
             x:DataType="vm:PerfilViewModel"
             Title="Mi Perfil"
             BackgroundColor="{StaticResource SurfaceAlt}"
             Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <Style x:Key="Caption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
        </Style>
        <Style x:Key="Valor" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PaddingLg}" Spacing="{StaticResource SpacingMd}">

            <HorizontalStackLayout Spacing="{StaticResource SpacingMd}">
                <Button Text="Atrás"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource OnPrimary}"
                        Padding="15,10"
                        CornerRadius="{StaticResource CornerRadiusMd}"
                        FontSize="{StaticResource FontBodySmall}"
                        ContentLayout="Left,8"
                        Clicked="OnBackClicked"
                        VerticalOptions="Center">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons"
                                         Glyph="{StaticResource IconoAtras}"
                                         Color="White"
                                         Size="18" />
                    </Button.ImageSource>
                </Button>
                <Label Text="Mi Perfil"
                       FontSize="{StaticResource FontTitle}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnSurface}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding Cargando}"
                               IsVisible="{Binding Cargando}"
                               Color="{StaticResource Primary}" />

            <Border BackgroundColor="{StaticResource Surface}"
                    StrokeThickness="0"
                    Padding="{StaticResource PaddingLg}"
                    IsVisible="{Binding HayError}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="{StaticResource SpacingMd}">
                    <Label Text="{Binding Error}"
                           FontSize="{StaticResource FontBodySmall}"
                           TextColor="{StaticResource Error}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Reintentar"
                            Command="{Binding CargarCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource OnPrimary}"
                            CornerRadius="{StaticResource CornerRadiusMd}"
                            ContentLayout="Left,6"
                            HorizontalOptions="Center">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons"
                                             Glyph="{StaticResource IconoReintentar}"
                                             Color="White"
                                             Size="16" />
                        </Button.ImageSource>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="{StaticResource SpacingMd}" IsVisible="{Binding HayDatos}">

                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        Padding="{StaticResource PaddingLg}"
                        HorizontalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="{StaticResource SpacingSm}">

                        <Border WidthRequest="84"
                                HeightRequest="84"
                                BackgroundColor="{StaticResource PrimarySoftStrong}"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Iniciales}"
                                   FontSize="{StaticResource FontDisplay}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <Label Text="{Binding Nombre}"
                               FontSize="{StaticResource FontHeading}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnSurface}"
                               HorizontalTextAlignment="Center"
                               Margin="0,6,0,0" />

                        <HorizontalStackLayout Spacing="{StaticResource SpacingSm}" HorizontalOptions="Center">
                            <Label Text="{StaticResource IconoCorreo}"
                                   Style="{StaticResource Icono}"
                                   FontSize="{StaticResource FontBodySmall}" />
                            <Label Text="{Binding Correo}"
                                   FontSize="{StaticResource FontBodySmall}"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        Padding="25,20"
                        HorizontalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="{StaticResource SpacingMd}">

                        <VerticalStackLayout Spacing="{StaticResource SpacingSm}">
                            <Label Text="Teléfono" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Telefono}" Style="{StaticResource Valor}" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Border}" />

                        <VerticalStackLayout Spacing="{StaticResource SpacingSm}">
                            <Label Text="Dirección" Style="{StaticResource Caption}" />
                            <HorizontalStackLayout Spacing="{StaticResource SpacingSm}">
                                <Label Text="{StaticResource IconoUbicacion}"
                                       Style="{StaticResource Icono}"
                                       FontSize="{StaticResource FontBody}" />
                                <Label Text="{Binding Direccion}" Style="{StaticResource Valor}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Button Text="Editar perfil"
                        Command="{Binding EditarCommand}"
                        HeightRequest="50"
                        CornerRadius="{StaticResource CornerRadiusMd}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource OnPrimary}"
                        FontSize="{StaticResource FontBody}"
                        FontAttributes="Bold"
                        ContentLayout="Left,8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons"
                                         Glyph="{StaticResource IconoEditar}"
                                         Color="White"
                                         Size="18" />
                    </Button.ImageSource>
                </Button>

                <Button Text="Cambiar contraseña"
                        Command="{Binding CambiarPasswordCommand}"
                        HeightRequest="50"
                        CornerRadius="{StaticResource CornerRadiusMd}"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        TextColor="{StaticResource Primary}"
                        FontSize="{StaticResource FontBody}"
                        FontAttributes="Bold"
                        ContentLayout="Left,8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons"
                                         Glyph="{StaticResource IconoCandado}"
                                         Color="{StaticResource Primary}"
                                         Size="18" />
                    </Button.ImageSource>
                </Button>

                <Button Text="Cerrar sesión"
                        Command="{Binding CerrarSesionCommand}"
                        HeightRequest="50"
                        CornerRadius="{StaticResource CornerRadiusMd}"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Error}"
                        BorderWidth="1"
                        TextColor="{StaticResource Error}"
                        FontSize="{StaticResource FontBody}"
                        FontAttributes="Bold"
                        ContentLayout="Left,8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons"
                                         Glyph="{StaticResource IconoSalir}"
                                         Color="{StaticResource Error}"
                                         Size="18" />
                    </Button.ImageSource>
                </Button>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>