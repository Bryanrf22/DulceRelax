<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:vm="clr-namespace:DulceRelax.App.Admin.ViewModels"
             x:Class="DulceRelax.App.Admin.Views.ClientesAdmin"
             x:DataType="vm:ClientesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceAlt}">
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>

    <RefreshView IsRefreshing="{Binding Cargando}"
                 Command="{Binding CargarCommand}"
                 RefreshColor="{StaticResource Primary}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PaddingLg}" Spacing="{StaticResource SpacingMd}">

                <Label Text="Clientes" FontSize="{StaticResource FontTitle}" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />

                <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderStrong}" StrokeThickness="1"
                        HeightRequest="48" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Busqueda}" Placeholder="Buscar por nombre, teléfono o correo"
                           ClearButtonVisibility="WhileEditing" FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource OnSurface}"
                           PlaceholderColor="{StaticResource OnSurfaceMuted}" BackgroundColor="Transparent" />
                </Border>

                <Label Text="{Binding Resumen}" FontSize="{StaticResource FontCaption}" TextColor="{StaticResource OnSurfaceVariant}" />

                <Border BackgroundColor="{StaticResource WarningSoft}" StrokeThickness="0" Padding="{StaticResource PaddingMd}"
                        IsVisible="{Binding SinConexion}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="{StaticResource SpacingSm}">
                        <Label Text="{StaticResource IconoSinConexion}"
                               Style="{StaticResource Icono}"
                               FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource WarningText}" />
                        <Label Text="{Binding AvisoSinConexion}" FontSize="{StaticResource FontCaption}"
                               TextColor="{StaticResource WarningText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="{StaticResource PaddingLg}"
                        IsVisible="{Binding HayError}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="{StaticResource SpacingMd}">
                        <Label Text="{Binding Error}" FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource Error}"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Reintentar" Command="{Binding CargarCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}" CornerRadius="{StaticResource CornerRadiusMd}"
                                ContentLayout="Left,6" HorizontalOptions="Center">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons"
                                                 Glyph="{StaticResource IconoReintentar}"
                                                 Color="White" Size="16" />
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="{StaticResource PaddingLg}"
                        IsVisible="{Binding SinResultados}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                    </Border.StrokeShape>
                    <Label Text="No se encontraron clientes." HorizontalTextAlignment="Center"
                           FontSize="{StaticResource FontBody}" TextColor="{StaticResource OnSurfaceVariant}" Margin="0,20" />
                </Border>

                <VerticalStackLayout Spacing="{StaticResource SpacingMd}" BindableLayout.ItemsSource="{Binding Clientes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClienteItem">
                            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1"
                                    Padding="{StaticResource PaddingMd}" HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusLg}" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="{StaticResource SpacingSm}">
                                    <Label Text="{Binding Nombre}" FontSize="{StaticResource FontBody}" FontAttributes="Bold"
                                           TextColor="{StaticResource OnSurface}" LineBreakMode="TailTruncation" MaxLines="2" />
                                    <Label Text="{Binding Correo}" FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource OnSurfaceVariant}" />
                                    <HorizontalStackLayout Spacing="{StaticResource SpacingSm}" IsVisible="{Binding TieneTelefono}">
                                        <Label Text="{StaticResource IconoTelefono}"
                                               Style="{StaticResource Icono}"
                                               FontSize="{StaticResource FontBodySmall}" />
                                        <Label Text="{Binding TelefonoTexto}" FontSize="{StaticResource FontCaption}"
                                               TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="{StaticResource SpacingSm}" IsVisible="{Binding TieneDireccion}">
                                        <Label Text="{StaticResource IconoUbicacion}"
                                               Style="{StaticResource Icono}"
                                               FontSize="{StaticResource FontBodySmall}" />
                                        <Label Text="{Binding Direccion}" FontSize="{StaticResource FontCaption}"
                                               TextColor="{StaticResource OnSurfaceVariant}" LineBreakMode="TailTruncation"
                                               MaxLines="2" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Button Text="Llamar" IsVisible="{Binding TieneTelefono}"
                                            HeightRequest="36" Padding="18,0" CornerRadius="{StaticResource CornerRadiusMd}"
                                            FontSize="{StaticResource FontCaption}" FontAttributes="Bold" HorizontalOptions="Start"
                                            ContentLayout="Left,6"
                                            BackgroundColor="Transparent" BorderColor="{StaticResource Primary}"
                                            BorderWidth="1" TextColor="{StaticResource Primary}" Margin="0,8,0,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClientesViewModel}}, x:DataType=vm:ClientesViewModel, Path=LlamarCommand}"
                                            CommandParameter="{Binding .}">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="MaterialIcons"
                                                             Glyph="{StaticResource IconoTelefono}"
                                                             Color="{StaticResource Primary}" Size="16" />
                                        </Button.ImageSource>
                                    </Button>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>