<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DulceRelax.App.Admin.ViewModels"
             x:Class="DulceRelax.App.Admin.Views.PrincipalAdmin"
             x:DataType="vm:AgendaViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FBF6F2">

    <Grid>

        <RefreshView IsRefreshing="{Binding Cargando}"
                     Command="{Binding CargarCommand}"
                     RefreshColor="#3F8758">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="15">

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Text="Agenda" FontSize="24" FontAttributes="Bold"
                               TextColor="#222222" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Hoy" Command="{Binding HoyCommand}"
                                BackgroundColor="Transparent" BorderColor="#3F8758" BorderWidth="1"
                                TextColor="#3F8758" CornerRadius="10" HeightRequest="36"
                                Padding="14,0" FontSize="12" FontAttributes="Bold" />
                    </Grid>

                    <Border BackgroundColor="White" StrokeThickness="0" Padding="8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Text="{StaticResource IconoAnterior}" Command="{Binding DiaAnteriorCommand}"
                                    FontFamily="MaterialIcons"
                                    BackgroundColor="Transparent" TextColor="#3F8758"
                                    FontSize="24" WidthRequest="50"
                                    SemanticProperties.Description="Día anterior" />
                            <Label Grid.Column="1" Text="{Binding DiaTexto}" FontSize="16"
                                   FontAttributes="Bold" TextColor="#262626"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            <Button Grid.Column="2" Text="{StaticResource IconoSiguiente}" Command="{Binding DiaSiguienteCommand}"
                                    FontFamily="MaterialIcons"
                                    BackgroundColor="Transparent" TextColor="#3F8758"
                                    FontSize="24" WidthRequest="50"
                                    SemanticProperties.Description="Día siguiente" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#FFF3CD" StrokeThickness="0" Padding="14"
                            IsVisible="{Binding SinConexion}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{StaticResource IconoSinConexion}"
                                   Style="{StaticResource Icono}"
                                   FontSize="14" TextColor="#8A6D3B" />
                            <Label Text="{Binding AvisoSinConexion}" FontSize="12"
                                   TextColor="#8A6D3B" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="White" StrokeThickness="0" Padding="25"
                            IsVisible="{Binding HayError}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding Error}" FontSize="14" TextColor="#B3261E"
                                   HorizontalTextAlignment="Center" />
                            <Button Text="Reintentar" Command="{Binding CargarCommand}"
                                    BackgroundColor="#3F8758" TextColor="White" CornerRadius="10"
                                    ContentLayout="Left,6" HorizontalOptions="Center">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="{StaticResource IconoReintentar}"
                                                     Color="White" Size="16" />
                                </Button.ImageSource>
                            </Button>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White" StrokeThickness="0" Padding="25"
                            IsVisible="{Binding SinCitas}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Label Text="No hay citas para este día." HorizontalTextAlignment="Center"
                               FontSize="15" TextColor="#777777" Margin="0,20" />
                    </Border>

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Citas}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CitaItem">
                                <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1"
                                        Padding="16" HorizontalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="6">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding HoraTexto}" FontSize="20"
                                                   FontAttributes="Bold" TextColor="#3F8758" />
                                            <Border Grid.Column="1" BackgroundColor="{Binding EstadoFondo}"
                                                    StrokeThickness="0" Padding="10,4">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding EstadoTexto}" FontSize="11"
                                                       FontAttributes="Bold" TextColor="{Binding EstadoColor}" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding MasajeNombre}" FontSize="16"
                                               FontAttributes="Bold" TextColor="#292929"
                                               LineBreakMode="TailTruncation" MaxLines="2" />
                                        <Label Text="{Binding Cliente}" FontSize="14" TextColor="#555555" />
                                        <HorizontalStackLayout Spacing="4" IsVisible="{Binding TieneTelefono}">
                                            <Label Text="{StaticResource IconoTelefono}"
                                                   Style="{StaticResource Icono}"
                                                   FontSize="13" />
                                            <Label Text="{Binding Telefono}" FontSize="12"
                                                   TextColor="#777777" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Direccion}" FontSize="12" TextColor="#777777" />
                                        <Label Text="{Binding Detalle}" IsVisible="{Binding TieneDetalle}"
                                               FontSize="11" TextColor="#999999" />

                                        <HorizontalStackLayout Spacing="10" Margin="0,8,0,0"
                                                               IsVisible="{Binding TieneAcciones}">
                                            <Button Text="Confirmar" IsVisible="{Binding PuedeConfirmar}"
                                                    HeightRequest="36" Padding="18,0" CornerRadius="10"
                                                    FontSize="12" FontAttributes="Bold" ContentLayout="Left,6"
                                                    BackgroundColor="#3F8758" TextColor="White"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AgendaViewModel}}, x:DataType=vm:AgendaViewModel, Path=ConfirmarCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="MaterialIcons"
                                                                     Glyph="{StaticResource IconoConfirmar}"
                                                                     Color="White" Size="16" />
                                                </Button.ImageSource>
                                            </Button>
                                            <Button Text="Reprogramar" IsVisible="{Binding PuedeReprogramar}"
                                                    HeightRequest="36" Padding="18,0" CornerRadius="10"
                                                    FontSize="12" FontAttributes="Bold"
                                                    BackgroundColor="Transparent" BorderColor="#3F8758"
                                                    BorderWidth="1" TextColor="#3F8758"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AgendaViewModel}}, x:DataType=vm:AgendaViewModel, Path=AbrirReprogramarCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Cancelar" IsVisible="{Binding PuedeCancelar}"
                                                    HeightRequest="36" Padding="18,0" CornerRadius="10"
                                                    FontSize="12" FontAttributes="Bold" ContentLayout="Left,6"
                                                    BackgroundColor="Transparent" BorderColor="#B3261E"
                                                    BorderWidth="1" TextColor="#B3261E"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AgendaViewModel}}, x:DataType=vm:AgendaViewModel, Path=CancelarCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="MaterialIcons"
                                                                     Glyph="{StaticResource IconoCerrar}"
                                                                     Color="#B3261E" Size="16" />
                                                </Button.ImageSource>
                                            </Button>
                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Grid IsVisible="{Binding MostrandoReprogramar}" BackgroundColor="#80000000">
            <Border BackgroundColor="White" StrokeThickness="0" Padding="20"
                    Margin="24" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Reprogramar cita" FontSize="18" FontAttributes="Bold"
                           TextColor="#222222" />
                    <Label Text="{Binding ReprogramandoTexto}" FontSize="13" TextColor="#777777" />
                    <DatePicker Date="{Binding NuevaFecha}" MinimumDate="{Binding FechaMinima}"
                                TextColor="#262626" />
                    <TimePicker Time="{Binding NuevaHora}" TextColor="#262626" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Cancelar" Command="{Binding CerrarReprogramarCommand}"
                                BackgroundColor="Transparent" BorderColor="#777777" BorderWidth="1"
                                TextColor="#777777" CornerRadius="10" />
                        <Button Grid.Column="1" Text="Guardar"
                                Command="{Binding GuardarReprogramarCommand}"
                                BackgroundColor="#3F8758" TextColor="White" CornerRadius="10" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>