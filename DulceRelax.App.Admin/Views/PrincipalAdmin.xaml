<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:vm="clr-namespace:DulceRelax.App.Admin.ViewModels"
             x:Class="DulceRelax.App.Admin.Views.PrincipalAdmin"
             x:DataType="vm:AgendaViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceAlt}">
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>

    <Grid>

        <RefreshView IsRefreshing="{Binding Cargando}"
                     Command="{Binding CargarCommand}"
                     RefreshColor="{StaticResource Primary}">
            <ScrollView>
                <VerticalStackLayout Padding="{StaticResource PaddingLg}" Spacing="{StaticResource SpacingMd}">

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpacingSm}">
                        <Label Text="Agenda" FontSize="{StaticResource FontTitle}" FontAttributes="Bold"
                               TextColor="{StaticResource OnSurface}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Hoy" Command="{Binding HoyCommand}"
                                BackgroundColor="Transparent" BorderColor="{StaticResource Primary}" BorderWidth="1"
                                TextColor="{StaticResource Primary}" CornerRadius="{StaticResource CornerRadiusMd}" HeightRequest="36"
                                Padding="14,0" FontSize="{StaticResource FontCaption}" FontAttributes="Bold"  automation_id="principal_hoy" />
                    </Grid>

                    <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="{StaticResource PaddingSm}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusLg}" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Text="{StaticResource IconoAnterior}" Command="{Binding DiaAnteriorCommand}"
                                    FontFamily="MaterialIcons"
                                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                                    FontSize="{StaticResource FontTitle}" WidthRequest="50"
                                    SemanticProperties.Description="Día anterior"  automation_id="principal__staticresource_icon" />
                            <Label Grid.Column="1" Text="{Binding DiaTexto}" FontSize="{StaticResource FontBody}"
                                   FontAttributes="Bold" TextColor="{StaticResource OnSurface}"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            <Button Grid.Column="2" Text="{StaticResource IconoSiguiente}" Command="{Binding DiaSiguienteCommand}"
                                    FontFamily="MaterialIcons"
                                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                                    FontSize="{StaticResource FontTitle}" WidthRequest="50"
                                    SemanticProperties.Description="Día siguiente"  automation_id="principal__staticresource_icon" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{StaticResource WarningSoft}" StrokeThickness="0" Padding="{StaticResource PaddingMd}"
                            IsVisible="{Binding SinConexion}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="{StaticResource SpacingSm}">
                            <Label Text="{StaticResource IconoSinConexion}"
                                   Style="{StaticResource Icono}"
                                   FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource WarningText}" />
                            <Label Text="{Binding AvisoSinConexion}" FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource WarningText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="{StaticResource PaddingLg}"
                            IsVisible="{Binding HayError}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="{StaticResource SpacingMd}">
                            <Label Text="{Binding Error}" FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource Error}"
                                   HorizontalTextAlignment="Center" />
                            <Button Text="Reintentar" Command="{Binding CargarCommand}"
                                    BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}" CornerRadius="{StaticResource CornerRadiusMd}"
                                    ContentLayout="Left,6" HorizontalOptions="Center">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="{StaticResource IconoReintentar}"
                                                     Color="White" Size="16" />
                                </Button.ImageSource>
                            </Button>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="{StaticResource PaddingLg}"
                            IsVisible="{Binding SinCitas}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                        </Border.StrokeShape>
                        <Label Text="No hay citas para este día." HorizontalTextAlignment="Center"
                               FontSize="{StaticResource FontBody}" TextColor="{StaticResource OnSurfaceVariant}" Margin="0,20" />
                    </Border>

                    <VerticalStackLayout Spacing="{StaticResource SpacingMd}" BindableLayout.ItemsSource="{Binding Citas}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CitaItem">
                                <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1"
                                        Padding="{StaticResource PaddingMd}" HorizontalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusLg}" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="{StaticResource SpacingSm}">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding HoraTexto}" FontSize="{StaticResource FontHeading}"
                                                   FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                            <Border Grid.Column="1" BackgroundColor="{Binding EstadoFondo}"
                                                    StrokeThickness="0" Padding="{StaticResource PaddingSm}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding EstadoTexto}" FontSize="{StaticResource FontCaption}"
                                                       FontAttributes="Bold" TextColor="{Binding EstadoColor}" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding MasajeNombre}" FontSize="{StaticResource FontBody}"
                                               FontAttributes="Bold" TextColor="{StaticResource OnSurface}"
                                               LineBreakMode="TailTruncation" MaxLines="2" />
                                        <Label Text="{Binding Cliente}" FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource OnSurfaceVariant}" />
                                        <HorizontalStackLayout Spacing="{StaticResource SpacingSm}" IsVisible="{Binding TieneTelefono}">
                                            <Label Text="{StaticResource IconoTelefono}"
                                                   Style="{StaticResource Icono}"
                                                   FontSize="{StaticResource FontBodySmall}" />
                                            <Label Text="{Binding Telefono}" FontSize="{StaticResource FontCaption}"
                                                   TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Direccion}" FontSize="{StaticResource FontCaption}" TextColor="{StaticResource OnSurfaceVariant}" />
                                        <Label Text="{Binding Detalle}" IsVisible="{Binding TieneDetalle}"
                                               FontSize="{StaticResource FontCaption}" TextColor="{StaticResource OnSurfaceMuted}" />

                                        <HorizontalStackLayout Spacing="{StaticResource SpacingMd}" Margin="0,8,0,0"
                                                               IsVisible="{Binding TieneAcciones}">
                                            <Button Text="Confirmar" IsVisible="{Binding PuedeConfirmar}"
                                                    HeightRequest="36" Padding="18,0" CornerRadius="{StaticResource CornerRadiusMd}"
                                                    FontSize="{StaticResource FontCaption}" FontAttributes="Bold" ContentLayout="Left,6"
                                                    BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AgendaViewModel}}, x:DataType=vm:AgendaViewModel, Path=ConfirmarCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="MaterialIcons"
                                                                     Glyph="{StaticResource IconoConfirmar}"
                                                                     Color="White" Size="16" />
                                                </Button.ImageSource>
                                            </Button>
                                            <Button Text="Reprogramar" IsVisible="{Binding PuedeReprogramar}"
                                                    HeightRequest="36" Padding="18,0" CornerRadius="{StaticResource CornerRadiusMd}"
                                                    FontSize="{StaticResource FontCaption}" FontAttributes="Bold"
                                                    BackgroundColor="Transparent" BorderColor="{StaticResource Primary}"
                                                    BorderWidth="1" TextColor="{StaticResource Primary}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AgendaViewModel}}, x:DataType=vm:AgendaViewModel, Path=AbrirReprogramarCommand}"
                                                    CommandParameter="{Binding .}"  automation_id="principal_reprogramar" />
                                            <Button Text="Cancelar" IsVisible="{Binding PuedeCancelar}"
                                                    HeightRequest="36" Padding="18,0" CornerRadius="{StaticResource CornerRadiusMd}"
                                                    FontSize="{StaticResource FontCaption}" FontAttributes="Bold" ContentLayout="Left,6"
                                                    BackgroundColor="Transparent" BorderColor="{StaticResource Error}"
                                                    BorderWidth="1" TextColor="{StaticResource Error}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AgendaViewModel}}, x:DataType=vm:AgendaViewModel, Path=CancelarCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="MaterialIcons"
                                                                     Glyph="{StaticResource IconoCerrar}"
                                                                     Color="{StaticResource Error}" Size="16" />
                                                </Button.ImageSource>
                                            </Button>
                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Grid IsVisible="{Binding MostrandoReprogramar}" BackgroundColor="{StaticResource Overlay}">
            <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="{StaticResource PaddingLg}"
                    Margin="{StaticResource MarginLg}" VerticalOptions="Center"
                    SemanticProperties.Description="Diálogo para reprogramar la cita seleccionada"
                    AutomationId="reprogramar_modal">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="{StaticResource SpacingMd}">
                    <Label Text="Reprogramar cita" FontSize="{StaticResource FontHeading}" FontAttributes="Bold"
                           TextColor="{StaticResource OnSurface}" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding ReprogramandoTexto}" FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource OnSurfaceVariant}" />
                    <DatePicker Date="{Binding NuevaFecha}" MinimumDate="{Binding FechaMinima}"
                                TextColor="{StaticResource OnSurface}" />
                    <TimePicker Time="{Binding NuevaHora}" TextColor="{StaticResource OnSurface}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingMd}">
                        <Button Text="Cancelar" Command="{Binding CerrarReprogramarCommand}"
                                BackgroundColor="Transparent" BorderColor="{StaticResource BorderStrong}" BorderWidth="1"
                                TextColor="{StaticResource OnSurfaceVariant}" CornerRadius="{StaticResource CornerRadiusMd}"
                                AutomationId="reprogramar_cancelar"
                                SemanticProperties.Description="Cerrar diálogo sin guardar" />
                        <Button Grid.Column="1" Text="Guardar"
                                Command="{Binding GuardarReprogramarCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}" CornerRadius="{StaticResource CornerRadiusMd}"
                                AutomationId="reprogramar_guardar"
                                SemanticProperties.Description="Guardar nueva fecha y hora de la cita" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>