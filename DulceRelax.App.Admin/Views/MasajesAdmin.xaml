<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:vm="clr-namespace:DulceRelax.App.Admin.ViewModels"
             x:Class="DulceRelax.App.Admin.Views.MasajesAdmin"
             x:DataType="vm:MasajesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceAlt}">
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>

    <RefreshView IsRefreshing="{Binding Cargando}"
                 Command="{Binding CargarCommand}"
                 RefreshColor="{StaticResource Primary}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PaddingLg}" Spacing="{StaticResource SpacingMd}">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Masajes" FontSize="{StaticResource FontTitle}" FontAttributes="Bold"
                           TextColor="{StaticResource OnSurface}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Nuevo" Command="{Binding NuevoCommand}"
                            BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}" CornerRadius="{StaticResource CornerRadiusMd}"
                            HeightRequest="36" Padding="16,0" FontSize="{StaticResource FontCaption}" FontAttributes="Bold"
                            ContentLayout="Left,6">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons"
                                             Glyph="{StaticResource IconoAgregar}"
                                             Color="White" Size="16" />
                        </Button.ImageSource>
                    </Button>
                </Grid>

                <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="{StaticResource PaddingLg}"
                        IsVisible="{Binding HayError}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="{StaticResource SpacingMd}">
                        <Label Text="{Binding Error}" FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource Error}"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Reintentar" Command="{Binding CargarCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}" CornerRadius="{StaticResource CornerRadiusMd}"
                                ContentLayout="Left,6" HorizontalOptions="Center">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons"
                                                 Glyph="{StaticResource IconoReintentar}"
                                                 Color="White" Size="16" />
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="{StaticResource PaddingLg}"
                        IsVisible="{Binding SinMasajes}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                    </Border.StrokeShape>
                    <Label Text="Aún no hay masajes registrados." HorizontalTextAlignment="Center"
                           FontSize="{StaticResource FontBody}" TextColor="{StaticResource OnSurfaceVariant}" Margin="0,20" />
                </Border>

                <VerticalStackLayout Spacing="{StaticResource SpacingMd}" BindableLayout.ItemsSource="{Binding Masajes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MasajeItem">
                            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1"
                                    Padding="{StaticResource PaddingMd}" HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusLg}" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="{StaticResource SpacingSm}">

                                    <Label Text="{Binding Nombre}" FontSize="{StaticResource FontBody}" FontAttributes="Bold"
                                           TextColor="{StaticResource OnSurface}" LineBreakMode="TailTruncation" MaxLines="2" />

                                    <Border BackgroundColor="{Binding EstadoFondo}" StrokeThickness="0"
                                            Padding="{StaticResource PaddingSm}" HorizontalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding EstadoTexto}" FontSize="{StaticResource FontCaption}"
                                               FontAttributes="Bold" TextColor="{Binding EstadoColor}" />
                                    </Border>

                                    <Label Text="{Binding PrecioTexto}" FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource OnSurfaceVariant}"
                                           Margin="0,4,0,0" />
                                    <HorizontalStackLayout Spacing="{StaticResource SpacingSm}" IsVisible="{Binding TieneDuracion}">
                                        <Label Text="{StaticResource IconoReloj}"
                                               Style="{StaticResource Icono}"
                                               FontSize="{StaticResource FontBodySmall}" />
                                        <Label Text="{Binding DuracionTexto}" FontSize="{StaticResource FontCaption}"
                                               TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="{StaticResource SpacingMd}" Margin="0,8,0,0">
                                        <Button Text="Editar" HeightRequest="36" Padding="18,0"
                                                CornerRadius="{StaticResource CornerRadiusMd}" FontSize="{StaticResource FontCaption}" FontAttributes="Bold"
                                                ContentLayout="Left,6"
                                                BackgroundColor="Transparent" BorderColor="{StaticResource Primary}"
                                                BorderWidth="1" TextColor="{StaticResource Primary}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MasajesViewModel}}, x:DataType=vm:MasajesViewModel, Path=EditarCommand}"
                                                CommandParameter="{Binding .}">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialIcons"
                                                                 Glyph="{StaticResource IconoEditar}"
                                                                 Color="{StaticResource Primary}" Size="16" />
                                            </Button.ImageSource>
                                        </Button>
                                        <Button Text="{Binding AccionTexto}" HeightRequest="36" Padding="18,0"
                                                CornerRadius="{StaticResource CornerRadiusMd}" FontSize="{StaticResource FontCaption}" FontAttributes="Bold"
                                                BackgroundColor="Transparent" BorderWidth="1"
                                                BorderColor="{Binding AccionColor}" TextColor="{Binding AccionColor}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MasajesViewModel}}, x:DataType=vm:MasajesViewModel, Path=AlternarCommand}"
                                                CommandParameter="{Binding .}"  AutomationId="masajes__binding_acciontexto" />
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>