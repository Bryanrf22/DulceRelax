<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:vm="clr-namespace:DulceRelax.App.Admin.ViewModels"
             x:Class="DulceRelax.App.Admin.Views.SolicitudesAdmin"
             x:DataType="vm:SolicitudesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceAlt}">
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>

    <RefreshView IsRefreshing="{Binding Cargando}"
                 Command="{Binding CargarCommand}"
                 RefreshColor="{StaticResource Primary}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PaddingLg}" Spacing="{StaticResource SpacingMd}">

                <Label Text="Solicitudes" FontSize="{StaticResource FontTitle}" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />

                <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="{StaticResource PaddingLg}"
                        IsVisible="{Binding HayError}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="{StaticResource SpacingMd}">
                        <Label Text="{Binding Error}" FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource Error}"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Reintentar" Command="{Binding CargarCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}" CornerRadius="{StaticResource CornerRadiusMd}"
                                ContentLayout="Left,6" HorizontalOptions="Center">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons"
                                                 Glyph="{StaticResource IconoReintentar}"
                                                 Color="White" Size="16" />
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="{StaticResource PaddingLg}"
                        IsVisible="{Binding SinSolicitudes}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                    </Border.StrokeShape>
                    <Label Text="No hay solicitudes pendientes." HorizontalTextAlignment="Center"
                           FontSize="{StaticResource FontBody}" TextColor="{StaticResource OnSurfaceVariant}" Margin="0,20" />
                </Border>

                <VerticalStackLayout Spacing="{StaticResource SpacingMd}" BindableLayout.ItemsSource="{Binding Citas}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CitaItem">
                            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1"
                                    Padding="{StaticResource PaddingMd}" HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusLg}" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="{StaticResource SpacingSm}">

                                    <Label Text="{Binding FechaHoraTexto}" FontSize="{StaticResource FontHeading}"
                                           FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                    <Label Text="{Binding MasajeNombre}" FontSize="{StaticResource FontBody}"
                                           FontAttributes="Bold" TextColor="{StaticResource OnSurface}"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                    <Label Text="{Binding Cliente}" FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource OnSurfaceVariant}" />
                                    <HorizontalStackLayout Spacing="{StaticResource SpacingSm}" IsVisible="{Binding TieneTelefono}">
                                        <Label Text="{StaticResource IconoTelefono}"
                                               Style="{StaticResource Icono}"
                                               FontSize="{StaticResource FontBodySmall}" />
                                        <Label Text="{Binding Telefono}" FontSize="{StaticResource FontCaption}"
                                               TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Direccion}" FontSize="{StaticResource FontCaption}" TextColor="{StaticResource OnSurfaceVariant}" />
                                    <Label Text="{Binding Detalle}" IsVisible="{Binding TieneDetalle}"
                                           FontSize="{StaticResource FontCaption}" TextColor="{StaticResource OnSurfaceMuted}" />

                                    <HorizontalStackLayout Spacing="{StaticResource SpacingMd}" Margin="0,8,0,0">
                                        <Button Text="Confirmar" HeightRequest="36" Padding="18,0"
                                                CornerRadius="{StaticResource CornerRadiusMd}" FontSize="{StaticResource FontCaption}" FontAttributes="Bold"
                                                ContentLayout="Left,6"
                                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SolicitudesViewModel}}, x:DataType=vm:SolicitudesViewModel, Path=ConfirmarCommand}"
                                                CommandParameter="{Binding .}">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialIcons"
                                                                 Glyph="{StaticResource IconoConfirmar}"
                                                                 Color="White" Size="16" />
                                            </Button.ImageSource>
                                        </Button>
                                        <Button Text="Rechazar" HeightRequest="36" Padding="18,0"
                                                CornerRadius="{StaticResource CornerRadiusMd}" FontSize="{StaticResource FontCaption}" FontAttributes="Bold"
                                                ContentLayout="Left,6"
                                                BackgroundColor="Transparent" BorderColor="{StaticResource Error}"
                                                BorderWidth="1" TextColor="{StaticResource Error}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SolicitudesViewModel}}, x:DataType=vm:SolicitudesViewModel, Path=RechazarCommand}"
                                                CommandParameter="{Binding .}">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialIcons"
                                                                 Glyph="{StaticResource IconoCerrar}"
                                                                 Color="{StaticResource Error}" Size="16" />
                                            </Button.ImageSource>
                                        </Button>
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>