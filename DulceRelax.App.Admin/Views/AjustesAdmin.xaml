<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:vm="clr-namespace:DulceRelax.App.Admin.ViewModels"
             x:Class="DulceRelax.App.Admin.Views.AjustesAdmin"
             x:DataType="vm:AjustesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceAlt}">
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>

    <RefreshView IsRefreshing="{Binding Cargando}"
                 Command="{Binding CargarCommand}"
                 RefreshColor="{StaticResource Primary}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PaddingLg}" Spacing="{StaticResource SpacingMd}">

                <Label Text="Ajustes" FontSize="{StaticResource FontTitle}" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                <Label Text="Horario de atención" FontSize="{StaticResource FontBody}" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />

                <Border BackgroundColor="{StaticResource WarningSoft}" StrokeThickness="0" Padding="{StaticResource PaddingMd}"
                        IsVisible="{Binding SinConfigurar}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                    </Border.StrokeShape>
                    <Label Text="Aún no hay un horario guardado. Mientras no lo guardes, los clientes pueden reservar a cualquier hora."
                           FontSize="{StaticResource FontCaption}" TextColor="{StaticResource WarningText}" />
                </Border>

                <VerticalStackLayout Spacing="{StaticResource SpacingMd}" BindableLayout.ItemsSource="{Binding Dias}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiaHorarioItem">
                            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1"
                                    Padding="16,10" HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusLg}" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="{StaticResource SpacingSm}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Nombre}" FontSize="{StaticResource FontBody}" FontAttributes="Bold"
                                               TextColor="{StaticResource OnSurface}" VerticalOptions="Center" />
                                        <Switch Grid.Column="1" IsToggled="{Binding Activo}"
                                                OnColor="{StaticResource Primary}" VerticalOptions="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="{StaticResource SpacingMd}"
                                          IsVisible="{Binding Activo}">
                                        <TimePicker Time="{Binding Inicio}" TextColor="{StaticResource OnSurface}" />
                                        <Label Grid.Column="1" Text="a" TextColor="{StaticResource OnSurfaceVariant}"
                                               VerticalOptions="Center" />
                                        <TimePicker Grid.Column="2" Time="{Binding Fin}" TextColor="{StaticResource OnSurface}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding Error}" IsVisible="{Binding HayError}" TextColor="{StaticResource Error}"
                       FontSize="{StaticResource FontBodySmall}" HorizontalTextAlignment="Center" />

                <Button Text="Guardar horario" Command="{Binding GuardarCommand}"
                        BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}" CornerRadius="{StaticResource CornerRadiusMd}"
                        HeightRequest="50" FontSize="{StaticResource FontBody}" FontAttributes="Bold" ContentLayout="Left,8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons"
                                         Glyph="{StaticResource IconoConfirmar}"
                                         Color="White" Size="18" />
                    </Button.ImageSource>
                </Button>

                <Button Text="Cerrar sesión" Command="{Binding CerrarSesionCommand}"
                        BackgroundColor="Transparent" BorderColor="{StaticResource Error}" BorderWidth="1"
                        TextColor="{StaticResource Error}" CornerRadius="{StaticResource CornerRadiusMd}" HeightRequest="50"
                        FontSize="{StaticResource FontBody}" FontAttributes="Bold" Margin="0,20,0,0" ContentLayout="Left,8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons"
                                         Glyph="{StaticResource IconoSalir}"
                                         Color="{StaticResource Error}" Size="18" />
                    </Button.ImageSource>
                </Button>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>