<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DulceRelax.App.Admin.ViewModels"
             x:Class="DulceRelax.App.Admin.Views.AjustesAdmin"
             x:DataType="vm:AjustesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FBF6F2">

    <RefreshView IsRefreshing="{Binding Cargando}"
                 Command="{Binding CargarCommand}"
                 RefreshColor="#3F8758">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label Text="Ajustes" FontSize="24" FontAttributes="Bold" TextColor="#222222" />
                <Label Text="Horario de atención" FontSize="16" FontAttributes="Bold" TextColor="#292929" />

                <Border BackgroundColor="#FFF3CD" StrokeThickness="0" Padding="14"
                        IsVisible="{Binding SinConfigurar}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="Aún no hay un horario guardado. Mientras no lo guardes, los clientes pueden reservar a cualquier hora."
                           FontSize="12" TextColor="#8A6D3B" />
                </Border>

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Dias}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiaHorarioItem">
                            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1"
                                    Padding="16,10" HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Nombre}" FontSize="15" FontAttributes="Bold"
                                               TextColor="#292929" VerticalOptions="Center" />
                                        <Switch Grid.Column="1" IsToggled="{Binding Activo}"
                                                OnColor="#3F8758" VerticalOptions="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10"
                                          IsVisible="{Binding Activo}">
                                        <TimePicker Time="{Binding Inicio}" TextColor="#333333" />
                                        <Label Grid.Column="1" Text="a" TextColor="#777777"
                                               VerticalOptions="Center" />
                                        <TimePicker Grid.Column="2" Time="{Binding Fin}" TextColor="#333333" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding Error}" IsVisible="{Binding HayError}" TextColor="#B3261E"
                       FontSize="13" HorizontalTextAlignment="Center" />

                <Button Text="Guardar horario" Command="{Binding GuardarCommand}"
                        BackgroundColor="#3F8758" TextColor="White" CornerRadius="15"
                        HeightRequest="50" FontSize="15" FontAttributes="Bold" ContentLayout="Left,8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons"
                                         Glyph="{StaticResource IconoConfirmar}"
                                         Color="White" Size="18" />
                    </Button.ImageSource>
                </Button>

                <Button Text="Cerrar sesión" Command="{Binding CerrarSesionCommand}"
                        BackgroundColor="Transparent" BorderColor="#B3261E" BorderWidth="1"
                        TextColor="#B3261E" CornerRadius="15" HeightRequest="50"
                        FontSize="15" FontAttributes="Bold" Margin="0,20,0,0" ContentLayout="Left,8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons"
                                         Glyph="{StaticResource IconoSalir}"
                                         Color="#B3261E" Size="18" />
                    </Button.ImageSource>
                </Button>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>