<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DulceRelax.UI.Behaviors;assembly=DulceRelax.UI"
             xmlns:vm="clr-namespace:DulceRelax.App.Admin.ViewModels"
             x:Class="DulceRelax.App.Admin.Views.MasajeFormAdmin"
             x:DataType="vm:MasajeFormViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceAlt}">
    <ContentPage.Behaviors>
        <behaviors:SafeAreaBehavior Edges="All" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PaddingLg}" Spacing="{StaticResource SpacingMd}">

            <HorizontalStackLayout Spacing="{StaticResource SpacingMd}">
                <Button Text="Atrás" Command="{Binding VolverCommand}"
                        BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}" Padding="15,10"
                        CornerRadius="{StaticResource CornerRadiusMd}" FontSize="{StaticResource FontBodySmall}" ContentLayout="Left,8"
                        VerticalOptions="Center">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons"
                                         Glyph="{StaticResource IconoAtras}"
                                         Color="White" Size="18" />
                    </Button.ImageSource>
                </Button>
                <Label Text="{Binding Titulo}" FontSize="{StaticResource FontTitle}" FontAttributes="Bold"
                       TextColor="{StaticResource OnSurface}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="{StaticResource PaddingLg}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusXl}" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="{StaticResource SpacingSm}">

                    <Label Text="Nombre" FontSize="{StaticResource FontBodySmall}" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                    <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderStrong}" StrokeThickness="1"
                            HeightRequest="48" Padding="12,0" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding Nombre}" Placeholder="Nombre del masaje" FontSize="{StaticResource FontBodySmall}"
                               TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource OnSurfaceMuted}" BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Descripción" FontSize="{StaticResource FontBodySmall}" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                    <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderStrong}" StrokeThickness="1"
                            Padding="12,4" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                        </Border.StrokeShape>
                        <Editor Text="{Binding Descripcion}" Placeholder="Descripción" HeightRequest="100"
                                FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource OnSurfaceMuted}"
                                BackgroundColor="Transparent" AutoSize="TextChanges" />
                    </Border>

                    <Label Text="Precio (C$)" FontSize="{StaticResource FontBodySmall}" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                    <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderStrong}" StrokeThickness="1"
                            HeightRequest="48" Padding="12,0" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding PrecioTexto}" Placeholder="0" Keyboard="Numeric" FontSize="{StaticResource FontBodySmall}"
                               TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource OnSurfaceMuted}" BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Duración (minutos)" FontSize="{StaticResource FontBodySmall}" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                    <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderStrong}" StrokeThickness="1"
                            HeightRequest="48" Padding="12,0" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding DuracionTexto}" Placeholder="60" Keyboard="Numeric" FontSize="{StaticResource FontBodySmall}"
                               TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource OnSurfaceMuted}" BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="URL de la imagen (opcional)" FontSize="{StaticResource FontBodySmall}" FontAttributes="Bold"
                           TextColor="{StaticResource OnSurface}" />
                    <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderStrong}" StrokeThickness="1"
                            HeightRequest="48" Padding="12,0" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusMd}" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding ImagenUrl}" Placeholder="https://..." Keyboard="Url" FontSize="{StaticResource FontBodySmall}"
                               TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource OnSurfaceMuted}" BackgroundColor="Transparent" />
                    </Border>

                    <HorizontalStackLayout Spacing="{StaticResource SpacingMd}" Margin="0,0,0,10" IsVisible="{Binding EsEdicion}">
                        <Switch IsToggled="{Binding Disponible}" OnColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Text="Disponible para los clientes" FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource OnSurfaceVariant}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding Error}" TextColor="{StaticResource Error}" FontSize="{StaticResource FontBodySmall}"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Guardar" Command="{Binding GuardarCommand}"
                            BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource OnPrimary}" CornerRadius="{StaticResource CornerRadiusMd}"
                            HeightRequest="50" FontSize="{StaticResource FontBody}" FontAttributes="Bold" ContentLayout="Left,8">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons"
                                             Glyph="{StaticResource IconoConfirmar}"
                                             Color="White" Size="18" />
                        </Button.ImageSource>
                    </Button>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>