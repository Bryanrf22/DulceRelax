<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="DulceRelax.UI.Theme.TypeTokens">

    <!-- Escala: 6 tamaños. Ningún texto informativo por debajo de 14. -->
    <x:Double x:Key="FontDisplay">28</x:Double>   <!-- bienvenida, registro -->
    <x:Double x:Key="FontTitle">22</x:Double>     <!-- título de pantalla -->
    <x:Double x:Key="FontHeading">18</x:Double>   <!-- sección / nombre de tarjeta -->
    <x:Double x:Key="FontBody">16</x:Double>      <!-- texto principal, precios -->
    <x:Double x:Key="FontBodySmall">14</x:Double> <!-- secundario, botones, campos -->
    <x:Double x:Key="FontCaption">12</x:Double>   <!-- solo metadatos y badges -->

    <!-- Interlineado (multiplicador). -->
    <x:Double x:Key="LineHeightTight">1.15</x:Double>
    <x:Double x:Key="LineHeightNormal">1.35</x:Double>

    <!-- Familias registradas en MauiProgram.cs de ambas apps -->
    <x:String x:Key="FontRegular">OpenSansRegular</x:String>
    <x:String x:Key="FontSemibold">OpenSansSemibold</x:String>

</ResourceDictionary>
