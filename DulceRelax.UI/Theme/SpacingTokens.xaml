<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="DulceRelax.UI.Theme.SpacingTokens">

    <!-- Padding -->
    <x:Double x:Key="PaddingSm">8</x:Double>
    <x:Double x:Key="PaddingMd">16</x:Double>
    <x:Double x:Key="PaddingLg">24</x:Double>
    <x:Double x:Key="PaddingXl">32</x:Double>

    <!-- Margen -->
    <x:Double x:Key="MarginSm">8</x:Double>
    <x:Double x:Key="MarginMd">16</x:Double>
    <x:Double x:Key="MarginLg">24</x:Double>

    <!-- Espaciado entre elementos -->
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">12</x:Double>
    <x:Double x:Key="SpacingLg">16</x:Double>
    <x:Double x:Key="SpacingXl">24</x:Double>

</ResourceDictionary>
